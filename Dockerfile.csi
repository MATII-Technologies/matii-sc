FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go/ ./go/
COPY csi/ ./csi/
WORKDIR /src/csi
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /matii-csi-provider ./cmd/matii-csi-provider

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /matii-csi-provider /usr/local/bin/matii-csi-provider
# The provider socket lives on a hostPath owned by root, like the driver's.
USER 0:0
ENTRYPOINT ["/usr/local/bin/matii-csi-provider"]
